# ============================================================
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTIFICATION_EMAIL=your-email@example.com
# FROM_EMAIL=MECHNEXUS Contact <noreply@yourdomain.com>
