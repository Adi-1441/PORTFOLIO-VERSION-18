# ============================================================
# SUPABASE EDGE FUNCTION SECRETS (server-side only)
# These are NOT VITE_ prefixed — they are set as Supabase secrets
# via CLI: supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxx
