{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["@types/deno"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "npm:@supabase/supabase-js@*": ["../../node_modules/@supabase/supabase-js"],
      "https://esm.sh/@supabase/supabase-js@*": ["../../node_modules/@supabase/supabase-js"],
      "@supabase/supabase-js": ["../../node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["./**/*.ts"]
}
